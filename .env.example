APP_NAME=Elite Games API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Reemplaza usuario, contraseña y host por los de tu instalación local.
DATABASE_URL=mysql+pymysql://root@localhost:3306/elite_games?charset=utf8mb4

# Autenticación
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
SESSION_INACTIVITY_MINUTES=30

# Correo (verificación de registro y recuperación de contraseña)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=CAMBIAR_APP_PASSWORD
SMTP_FROM_NAME=Elite Games
RESET_TOKEN_EXPIRE_MINUTES=15
FRONTEND_URL=http://localhost:5173

# Opcional: envío por API HTTP (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
